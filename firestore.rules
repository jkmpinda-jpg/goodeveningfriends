rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email; }
    // the two root admins can never be locked out; more admins are added from the Teacher's Desk (settings/admins)
    function isRoot() { return signedIn() && email() in ['jkmpinda@gmail.com', 'goodeveningfriends7@gmail.com']; }
    function isAdmin() {
      return isRoot() || (signedIn()
        && exists(/databases/$(database)/documents/settings/admins)
        && email() in get(/databases/$(database)/documents/settings/admins).data.emails);
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // site settings (incl. the admin list): readable by signed-in members so the app knows who holds the keys; written only by the root admins
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isRoot();
    }

    // profile: owner writes; owner or admin reads (member / email / SMS lists); owner may delete their seat
    match /users/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow write: if owner(uid);
      // scores, notes — owner only, private even from admin; owner may delete (restart journey)
      match /{document=**} { allow read, write: if owner(uid); }
    }

    // legacy single chat thread (v2) — kept readable
    match /chats/{uid} {
      allow read, write: if owner(uid) || isAdmin();
      match /messages/{mid} {
        allow read: if owner(uid) || isAdmin();
        allow create: if (owner(uid) && request.resource.data.from == 'user') || (isAdmin() && request.resource.data.from == 'jonathan');
      }
    }

    // v3 conversations — many private threads per member, attachments inline
    match /conversations/{cid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      match /messages/{mid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/conversations/$(cid)).data.uid == request.auth.uid || isAdmin());
        allow create: if signedIn() && request.resource.data.size() <= 6 &&
          ((get(/databases/$(database)/documents/conversations/$(cid)).data.uid == request.auth.uid && request.resource.data.from == 'user')
           || (isAdmin() && request.resource.data.from == 'jonathan'));
      }
    }

    // polls: admin creates/edits; signed-in read; one vote per user
    match /polls/{pollId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /votes/{uid} { allow read: if signedIn(); allow write: if owner(uid); }
    }

    // image vault: public credits, admin curates
    match /vault/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
